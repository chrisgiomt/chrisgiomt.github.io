---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
---

<article class="group relative flex flex-col items-start justify-between p-6 bg-white dark:bg-zinc-800/50 rounded-2xl ring-1 ring-slate-200 dark:ring-zinc-700 hover:ring-blue-500 dark:hover:ring-blue-500 transition-all hover:shadow-lg dark:hover:shadow-blue-900/20">
  <div class="flex items-center gap-x-4 text-xs">
    <time datetime={project.data.completionDate.toISOString()} class="text-slate-500 dark:text-slate-400 font-medium">
      {project.data.completionDate.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}
    </time>
  </div>
  
  <div class="max-w-xl">
    <h2 class="mt-3 text-xl font-bold leading-6 text-slate-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors tracking-tight">
      <a href={`/projects/${project.id}`}>
        <span class="absolute inset-0"></span>
        {project.data.title}
      </a>
    </h2>
    <p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-400 line-clamp-3">
      {project.data.description}
    </p>
  </div>
  
  <div class="mt-5 flex flex-wrap gap-2">
    {project.data.techStack.map(tech => (
      <span class="inline-flex items-center rounded-md bg-blue-50 dark:bg-blue-900/30 px-2 py-1 text-xs font-medium text-blue-700 dark:text-blue-300 ring-1 ring-inset ring-blue-700/10 dark:ring-blue-400/20">
        {tech}
      </span>
    ))}
  </div>
</article>
