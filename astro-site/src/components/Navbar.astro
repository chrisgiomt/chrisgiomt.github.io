---
import ThemeToggle from './ThemeToggle.astro';

const pathname = new URL(Astro.request.url).pathname;
const isBlog = pathname.startsWith('/blog');
const isNow = pathname.startsWith('/now');
const isProjects = pathname.startsWith('/projects');
---

<nav class="sticky top-0 z-50 w-full backdrop-blur-md bg-white/70 dark:bg-zinc-900/80 border-b border-slate-200 dark:border-slate-800 transition-colors duration-300">
  <div class="max-w-5xl mx-auto px-6 h-16 flex items-center justify-between relative z-20">
    <!-- Logo -->
    <a href="/" class="text-xl font-bold tracking-tighter text-slate-900 dark:text-white">
      Christopher <span class="text-slate-400 dark:text-zinc-500 font-normal mx-1">|</span> <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-indigo-600 dark:from-blue-400 dark:to-indigo-400">Main</span>
    </a>

    <!-- Desktop Navigation Links -->
    <div class="hidden md:flex items-center space-x-8">
      <a href="/now" aria-current={isNow ? "page" : undefined} class={`text-sm font-medium transition-colors ${isNow ? 'text-blue-600 dark:text-blue-400' : 'text-slate-600 dark:text-slate-300 hover:text-blue-600 dark:hover:text-blue-400'}`}>Now</a>
      <a href="/blog" aria-current={isBlog ? "page" : undefined} class={`text-sm font-medium transition-colors ${isBlog ? 'text-blue-600 dark:text-blue-400' : 'text-slate-600 dark:text-slate-300 hover:text-blue-600 dark:hover:text-blue-400'}`}>Blog</a>
      <a href="/projects" aria-current={isProjects ? "page" : undefined} class={`text-sm font-medium transition-colors ${isProjects ? 'text-blue-600 dark:text-blue-400' : 'text-slate-600 dark:text-slate-300 hover:text-blue-600 dark:hover:text-blue-400'}`}>Projects</a>
    </div>

    <!-- Actions -->
    <div class="flex items-center space-x-3 md:space-x-4">
      
      <!-- Search Command Palette Toggle -->
      <button 
        id="navbar-search-btn" 
        class="flex items-center gap-2 px-3 py-1.5 text-sm text-slate-500 dark:text-zinc-400 bg-slate-100 dark:bg-zinc-800/80 rounded-lg hover:bg-slate-200 dark:hover:bg-zinc-700 transition-colors ring-1 ring-inset ring-slate-200 dark:ring-zinc-700/50 focus:outline-none focus:ring-2 focus:ring-blue-500"
        aria-label="Open Command Palette"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
        <span class="hidden md:inline-block">Search...</span>
        <kbd class="hidden md:inline-block ml-1 px-1.5 py-0.5 text-[10px] font-mono font-bold text-slate-400 dark:text-zinc-500 bg-white dark:bg-zinc-900 rounded shadow-sm border border-slate-200 dark:border-zinc-800">Ctrl K</kbd>
      </button>

      <ThemeToggle />
      
      <!-- Mobile Menu Toggle Button -->
      <button 
        id="mobile-menu-toggle" 
        aria-label="Toggle mobile menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="md:hidden p-2 -mr-2 rounded-lg text-slate-800 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors focus:outline-none focus:ring-2 focus:ring-blue-500"
      >
        <div class="w-5 h-5 flex flex-col justify-center items-center relative">
          <span class="bg-current block w-5 h-[2px] absolute transition-all duration-300 ease-in-out -translate-y-1.5" id="hamburger-line-1"></span>
          <span class="bg-current block w-5 h-[2px] absolute transition-all duration-300 ease-in-out" id="hamburger-line-2"></span>
          <span class="bg-current block w-5 h-[2px] absolute transition-all duration-300 ease-in-out translate-y-1.5" id="hamburger-line-3"></span>
        </div>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation Dropdown -->
  <div 
    id="mobile-menu" 
    class="md:hidden absolute top-full left-0 w-full overflow-hidden transition-all duration-300 ease-in-out max-h-0 opacity-0 pointer-events-none bg-white/95 dark:bg-zinc-900/95 backdrop-blur-xl border-b border-slate-200 dark:border-slate-800 shadow-xl"
  >
    <div class="px-6 py-6 flex flex-col space-y-4">
      <a href="/now" aria-current={isNow ? "page" : undefined} class={`block text-lg font-medium transition-colors ${isNow ? 'text-blue-600 dark:text-blue-400' : 'text-slate-900 dark:text-white hover:text-blue-600 dark:hover:text-blue-400'}`}>Now</a>
      <a href="/blog" aria-current={isBlog ? "page" : undefined} class={`block text-lg font-medium transition-colors ${isBlog ? 'text-blue-600 dark:text-blue-400' : 'text-slate-900 dark:text-white hover:text-blue-600 dark:hover:text-blue-400'}`}>Blog</a>
      <a href="/projects" aria-current={isProjects ? "page" : undefined} class={`block text-lg font-medium transition-colors ${isProjects ? 'text-blue-600 dark:text-blue-400' : 'text-slate-900 dark:text-white hover:text-blue-600 dark:hover:text-blue-400'}`}>Projects</a>
    </div>
  </div>
</nav>

<script is:inline>
  window.initMobileMenu = function() {
    const toggleBtn = document.getElementById('mobile-menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const line1 = document.getElementById('hamburger-line-1');
    const line2 = document.getElementById('hamburger-line-2');
    const line3 = document.getElementById('hamburger-line-3');
    
    if (!toggleBtn || !mobileMenu) return;

    // Check if we've already attached the event listener to avoid duplicates
    if (toggleBtn.dataset.initialized) return;
    toggleBtn.dataset.initialized = 'true';

    let isMenuOpen = false;

    toggleBtn.addEventListener('click', () => {
      isMenuOpen = !isMenuOpen;
      toggleBtn.setAttribute('aria-expanded', isMenuOpen);
      
      if (isMenuOpen) {
        // Open Menu
        mobileMenu.classList.remove('max-h-0', 'opacity-0', 'pointer-events-none');
        mobileMenu.classList.add('max-h-[400px]', 'opacity-100', 'pointer-events-auto');
        
        // Animate Hamburger to X
        line1.classList.remove('-translate-y-1.5');
        line1.classList.add('rotate-45');
        
        line2.classList.add('opacity-0');
        
        line3.classList.remove('translate-y-1.5');
        line3.classList.add('-rotate-45');
      } else {
        // Close Menu
        mobileMenu.classList.remove('max-h-[400px]', 'opacity-100', 'pointer-events-auto');
        mobileMenu.classList.add('max-h-0', 'opacity-0', 'pointer-events-none');
        
        // Animate X back to Hamburger
        line1.classList.remove('rotate-45');
        line1.classList.add('-translate-y-1.5');
        
        line2.classList.remove('opacity-0');
        
        line3.classList.remove('-rotate-45');
        line3.classList.add('translate-y-1.5');
      }
    });

    // Command Palette Button binding
    const searchBtn = document.getElementById('navbar-search-btn');
    if (searchBtn && !searchBtn.dataset.initialized) {
      searchBtn.dataset.initialized = 'true';
      searchBtn.addEventListener('click', () => {
        if (window.openCommandPalette) window.openCommandPalette();
      });
    }
  };

  // Run on initial load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', window.initMobileMenu);
  } else {
    window.initMobileMenu();
  }
  
  // Run on subsequent view transitions (if Astro ClientRouter is added later)
  if (!window.mobileMenuListenerAttached) {
    document.addEventListener('astro:after-swap', () => window.initMobileMenu());
    document.addEventListener('astro:page-load', () => window.initMobileMenu());
    window.mobileMenuListenerAttached = true;
  }
</script>
