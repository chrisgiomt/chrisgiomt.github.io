---
import ThemeToggle from './ThemeToggle.astro';
---

<nav class="sticky top-0 z-50 w-full backdrop-blur-md bg-white/70 dark:bg-zinc-900/80 border-b border-slate-200 dark:border-slate-800 transition-colors duration-300">
  <div class="max-w-5xl mx-auto px-6 h-16 flex items-center justify-between">
    <!-- Logo -->
    <a href="/" class="text-xl font-bold tracking-tighter text-slate-900 dark:text-white">
      Christopher <span class="text-slate-400 dark:text-zinc-500 font-normal mx-1">|</span> <span class="text-blue-600 dark:text-blue-400">Main</span>
    </a>

    <!-- Navigation Links -->
    <div class="hidden md:flex items-center space-x-8">
      <a href="/blog" class="text-sm font-medium text-slate-600 dark:text-slate-300 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Blog</a>
      <a href="/projects" class="text-sm font-medium text-slate-600 dark:text-slate-300 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Projects</a>
    </div>

    <!-- Actions -->
    <div class="flex items-center space-x-4">
      <ThemeToggle />
    </div>
  </div>
</nav>
