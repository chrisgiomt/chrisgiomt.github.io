---
interface Props {
  type?: 'info' | 'warning' | 'success' | 'danger';
  title?: string;
}

const { type = 'info', title } = Astro.props;

// Tailwind classes mapping for different callout states
const styles = {
  info: 'bg-blue-50 dark:bg-blue-900/20 border-blue-500 text-blue-900 dark:text-blue-100',
  warning: 'bg-amber-50 dark:bg-amber-900/20 border-amber-500 text-amber-900 dark:text-amber-100',
  success: 'bg-emerald-50 dark:bg-emerald-900/20 border-emerald-500 text-emerald-900 dark:text-emerald-100',
  danger: 'bg-red-50 dark:bg-red-900/20 border-red-500 text-red-900 dark:text-red-100'
};

// SVG Icon paths for the different states
const icons = {
  info: 'M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
  warning: 'M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z',
  success: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z',
  danger: 'M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z'
};

const currentStyle = styles[type];
const currentIcon = icons[type];
---

<div class={`not-prose my-8 flex gap-4 rounded-xl border-l-4 p-5 ${currentStyle} shadow-sm transition-all hover:shadow-md`}>
  <div class="flex-shrink-0 mt-0.5">
    <svg class="h-6 w-6 opacity-80" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d={currentIcon} />
    </svg>
  </div>
  <div class="flex-1 min-w-0">
    {title && <h4 class="text-sm font-bold tracking-wide mb-1.5 uppercase opacity-90">{title}</h4>}
    <div class="text-sm leading-relaxed opacity-90">
      <slot />
    </div>
  </div>
</div>
