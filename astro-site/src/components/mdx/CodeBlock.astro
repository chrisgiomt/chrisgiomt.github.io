---
const props = Astro.props;
---

<div class="not-prose my-8 rounded-xl overflow-hidden shadow-xl ring-1 ring-slate-200 dark:ring-white/10 min-w-0 w-full relative group">
  <!-- Mac OS Terminal Window Header -->
  <div class="flex items-center justify-between px-4 py-3 border-b border-slate-200 dark:border-zinc-800 bg-slate-100 dark:bg-zinc-950">
    <div class="flex space-x-2">
      <div class="w-3 h-3 rounded-full bg-red-400 dark:bg-red-500/90"></div>
      <div class="w-3 h-3 rounded-full bg-amber-400 dark:bg-yellow-500/90"></div>
      <div class="w-3 h-3 rounded-full bg-emerald-400 dark:bg-green-500/90"></div>
    </div>
    
    <!-- Copy Button -->
    <button
      type="button"
      class="copy-code-btn flex items-center justify-center text-slate-400 hover:text-slate-600 dark:text-slate-500 dark:hover:text-slate-300 transition-colors focus:outline-none focus:ring-2 focus:ring-blue-500 rounded p-1"
      aria-label="Copy code to clipboard"
    >
      <svg class="w-4 h-4 copy-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
      <svg class="w-4 h-4 check-icon hidden text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
    </button>
  </div>
  
  <!-- Shiki Code Output -->
  <div class="[&>pre]:!m-0 [&>pre]:!p-5 [&>pre]:!rounded-none [&>pre]:!bg-transparent [&>pre]:overflow-x-auto text-sm leading-relaxed overflow-x-auto w-full min-w-0">
    <pre {...props}>
      <slot />
    </pre>
  </div>
</div>

<script is:inline>
  window.initMDXCodeBlocks = function() {
    const copyButtons = document.querySelectorAll('.copy-code-btn');
    
    copyButtons.forEach(btn => {
      // Prevent duplicate listeners
      if (btn.dataset.initialized) return;
      btn.dataset.initialized = 'true';

      btn.addEventListener('click', async () => {
        const wrapper = btn.closest('.not-prose');
        if (!wrapper) return;
        
        const codeElement = wrapper.querySelector('pre');
        if (codeElement) {
          const textToCopy = codeElement.textContent;
          try {
            await navigator.clipboard.writeText(textToCopy || '');
            
            const copyIcon = btn.querySelector('.copy-icon');
            const checkIcon = btn.querySelector('.check-icon');
            
            if (copyIcon && checkIcon) {
              copyIcon.classList.add('hidden');
              checkIcon.classList.remove('hidden');
              
              setTimeout(() => {
                copyIcon.classList.remove('hidden');
                checkIcon.classList.add('hidden');
              }, 2000);
            }
          } catch (err) {
            console.error('Failed to copy text: ', err);
            // Fallback UI for denied clipboard permissions
            btn.classList.add('text-red-500');
            setTimeout(() => {
              btn.classList.remove('text-red-500');
            }, 2000);
          }
        }
      });
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', window.initMDXCodeBlocks);
  } else {
    window.initMDXCodeBlocks();
  }
  
  if (!window.mdxCodeBlocksListenerAttached) {
    document.addEventListener('astro:after-swap', () => window.initMDXCodeBlocks());
    window.mdxCodeBlocksListenerAttached = true;
  }
</script>
