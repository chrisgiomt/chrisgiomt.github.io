---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getRecentBlogPosts } from '../utils/api';
import Timeline from '../components/Timeline.astro';

const recentPosts = await getRecentBlogPosts(3);
---

<BaseLayout title="Christopher | Main" description="Personal portfolio and blog focusing on Networking, AWS, Cybersecurity, and AI.">
  <!-- Hero Section -->
  <section class="pt-20 pb-16 md:pt-32 md:pb-24 px-6 max-w-5xl mx-auto">
    <div class="max-w-3xl">
      <h1 class="text-5xl md:text-7xl font-extrabold text-slate-900 dark:text-white tracking-tight mb-6">
        Hi, I'm <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-indigo-600 dark:from-blue-400 dark:to-indigo-400">Chris.</span>
      </h1>
      <p class="text-xl md:text-2xl text-slate-600 dark:text-zinc-400 leading-relaxed mb-10">
        I am a tech enthusiast focusing on Networking, AWS, Cybersecurity, and AI. I build secure, scalable, and intelligent cloud solutions.
      </p>
      <div class="flex flex-wrap gap-4">
        <a href="/projects" class="px-6 py-3 bg-slate-900 dark:bg-white text-white dark:text-slate-900 font-semibold rounded-lg hover:bg-slate-800 dark:hover:bg-slate-200 transition-colors shadow-sm">
          View Projects
        </a>
        <a href="/blog" class="px-6 py-3 bg-slate-100 dark:bg-zinc-800 text-slate-900 dark:text-white font-semibold rounded-lg hover:bg-slate-200 dark:hover:bg-zinc-700 transition-colors">
          Read the Blog
        </a>
      </div>
    </div>
  </section>

  <!-- Timeline Section -->
  <section class="px-6 py-20 bg-slate-50 dark:bg-zinc-900 border-t border-slate-200 dark:border-zinc-800 relative overflow-hidden">
    <!-- Subtle background decoration -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-4xl h-64 bg-blue-500/5 dark:bg-blue-500/10 blur-3xl rounded-full pointer-events-none"></div>
    
    <div class="max-w-5xl mx-auto relative z-10">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight mb-4">The Journey So Far</h2>
        <p class="text-lg text-slate-600 dark:text-zinc-400 max-w-2xl mx-auto">A timeline of my professional growth, certifications, and technical milestones.</p>
      </div>
      
      <Timeline />
    </div>
  </section>

  <!-- Recent Posts Section -->
  <section class="px-6 py-20 bg-slate-50/50 dark:bg-zinc-900/50 border-t border-slate-200 dark:border-zinc-800">
    <div class="max-w-5xl mx-auto">
      <div class="flex justify-between items-end mb-10">
        <h2 class="text-3xl font-bold text-slate-900 dark:text-white tracking-tight">Recent Posts</h2>
        <a href="/blog" class="text-sm font-medium text-blue-600 dark:text-blue-400 hover:underline">View all &rarr;</a>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {recentPosts.map((post) => (
          <article class="group relative flex flex-col p-6 bg-white dark:bg-zinc-800/50 rounded-2xl ring-1 ring-slate-200 dark:ring-zinc-700 hover:ring-blue-500 dark:hover:ring-blue-500 transition-all hover:shadow-lg dark:hover:shadow-blue-900/20 h-full">
            <div class="text-sm text-slate-500 dark:text-zinc-400 mb-3 font-medium">
              <time datetime={post.data.pubDate.toISOString()}>
                {post.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
              </time>
            </div>
            <h3 class="text-xl font-bold mb-3 tracking-tight line-clamp-2 text-slate-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
              <a href={`/blog/${post.id}`}>
                <span class="absolute inset-0"></span>
                {post.data.title}
              </a>
            </h3>
            <p class="text-sm text-slate-600 dark:text-zinc-400 line-clamp-3 mt-auto leading-relaxed">
              {post.data.description}
            </p>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
