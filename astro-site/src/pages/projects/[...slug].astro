---
import { render } from 'astro:content';
import { getProjects } from '../../utils/api';
import ProjectLayout from '../../layouts/ProjectLayout.astro';
import CodeBlock from '../../components/mdx/CodeBlock.astro';

// Tells Astro 5 which dynamic routes to generate
export async function getStaticPaths() {
  const projectEntries = await getProjects();
  return projectEntries.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<ProjectLayout entry={entry}>
  <!-- Content component renders the compiled MDX using @tailwindcss/typography -->
  <Content components={{ pre: CodeBlock }} />
</ProjectLayout>
