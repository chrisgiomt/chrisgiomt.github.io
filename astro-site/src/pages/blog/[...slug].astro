---
import { render } from 'astro:content';
import { getBlogPosts } from '../../utils/api';
import PostLayout from '../../layouts/PostLayout.astro';
import CodeBlock from '../../components/mdx/CodeBlock.astro';

// This function tells Astro which dynamic routes to generate at build time
export async function getStaticPaths() {
  const blogEntries = await getBlogPosts();
  return blogEntries.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<PostLayout entry={entry}>
  <!-- Content component renders the compiled MDX -->
  <Content components={{ pre: CodeBlock }} />
</PostLayout>
